{
  "name": "vuewrite-monorepo",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --cwd packages/dev-app dev",
    "build": "bun run --cwd packages/vuewrite build",
    "build:app": "bun run --cwd packages/dev-app build",
    "test": "bun run --cwd packages/vuewrite test && bun run --cwd packages/markdown test"
  }
}
