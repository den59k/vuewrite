{
  "name": "vuewrite",
  "description": "Rich Text Editor based on Vue3 reactivity",
  "private": false,
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "author": "den59k",
  "repository": {
    "type": "git",
    "url": "https://github.com/den59k/vuewrite.git"
  },
  "main": "dist/vuewrite.js",
  "types": "dist/vuewrite.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vuewrite.js",
      "types": "./dist/vuewrite.d.ts"
    },
    "./markdown": {
      "import": "./dist/markdown.js",
      "types": "./dist/markdown.d.ts"
    }
  },
  "scripts": {
    "build": "vue-tsc && vite build",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^4.1.7",
    "vue-tsc": "^2.0.6",
    "vuesix": "^1.0.12",
    "vuewrite-markdown": "workspace:*"
  },
  "files": ["dist", "README.md", "API.md", "LICENSE"]
}
